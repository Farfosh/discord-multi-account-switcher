{
  "manifest_version": 3,
  "name": "Discord Profile Switcher",
  "version": "1.8.0",
  "minimum_chrome_version": "105",
  "description": "Open isolated Discord Chrome profiles without storing or injecting account tokens.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Discord Profile Switcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  }
}
